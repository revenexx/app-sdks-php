{
    "name": "revenexx/app-sdk",
    "description": "revenexx App SDK for PHP — typed data client (mock | remote | runtime adapters), router with one-line CRUD, settings and the acting person for revenexx App functions on the open-runtimes PHP runtime (ADR-0013 / ADR-0057).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "revenexx",
        "app-sdk",
        "postgrest",
        "open-runtimes",
        "sdk"
    ],
    "homepage": "https://github.com/revenexx/app-sdks-php",
    "authors": [
        {
            "name": "revenexx",
            "homepage": "https://revenexx.com"
        }
    ],
    "support": {
        "source": "https://github.com/revenexx/app-sdks-php"
    },
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Revenexx\\AppSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Revenexx\\AppSdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
