{
    "name": "revenexx/app-sdk",
    "description": "revenexx App SDK for PHP — build revenexx Apps: a typed data client (mock, remote and runtime adapters), a router with one-line CRUD routes, App settings, the acting person and App events.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "revenexx",
        "app-sdk",
        "sdk",
        "postgrest",
        "open-runtimes",
        "serverless"
    ],
    "homepage": "https://packagist.org/packages/revenexx/app-sdk",
    "authors": [
        {
            "name": "revenexx",
            "homepage": "https://revenexx.com"
        }
    ],
    "support": {
        "source": "https://github.com/revenexx/app-sdks-php",
        "docs": "https://github.com/revenexx/app-sdks-php#readme"
    },
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Revenexx\\AppSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Revenexx\\AppSdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
